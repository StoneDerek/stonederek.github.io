---
import site from '../data/site.json';
import '../styles/portfolio.css';
import { ClientRouter } from 'astro:transitions';
import { projectIcon } from '../data/project-icons.js';
import { homePalette, darkHomePalette } from '../data/section-palettes.js';
import { sectionTiming } from '../data/section-motion.js';
import { initializeTheme, themeStorageKey } from '../scripts/theme.js';
const { title = site.title, description = site.description, favicon = projectIcon(homePalette), darkFavicon = Astro.props.favicon ? favicon : projectIcon(darkHomePalette) } = Astro.props;
const themeStartup = `(${initializeTheme.toString()})(${JSON.stringify(themeStorageKey)});`;
---
<!doctype html>
<html lang="en" transition:name="root" transition:animate="none" style={`--section-exit:${sectionTiming.exit}ms;--section-enter:${sectionTiming.enter}ms;--section-header:${sectionTiming.header}ms;--section-artwork:${sectionTiming.artwork}ms;--section-ease:${sectionTiming.easing}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={favicon} type="image/svg+xml" data-project-favicon data-theme-light-favicon={favicon} data-theme-dark-favicon={darkFavicon} />
    <script is:inline set:html={themeStartup} />
    <ClientRouter />
  </head>
  <body>
    <slot />
    <script>import '../scripts/section-navigation.js';</script>
  </body>
</html>
