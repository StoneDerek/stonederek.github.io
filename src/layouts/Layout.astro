---
import site from '../data/site.json';
import '../styles/portfolio.css';
import { projectIcon } from '../data/project-icons.js';
import { homePalette, darkHomePalette } from '../data/section-palettes.js';
import { initializeTheme, themeStorageKey, appearanceEnabled } from '../scripts/theme.js';
const { title = site.title, description = site.description, favicon = projectIcon(homePalette), darkFavicon = Astro.props.favicon ? favicon : projectIcon(darkHomePalette) } = Astro.props;
const themeStartup = `(${initializeTheme.toString()})(${JSON.stringify(themeStorageKey)},${appearanceEnabled});`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const sharingImage = new URL(`${import.meta.env.BASE_URL}social-preview.png`, Astro.site);
const sharingImageAlt = `${site.name} — Portfolio`;
---
<!doctype html>
<html lang="en" data-theme={appearanceEnabled ? undefined : 'light'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={sharingImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={sharingImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={sharingImage} />
    <meta name="twitter:image:alt" content={sharingImageAlt} />
    <link rel="icon" href={favicon} type="image/svg+xml" data-project-favicon data-theme-light-favicon={favicon} data-theme-dark-favicon={darkFavicon} />
    <script is:inline set:html={themeStartup} />
  </head>
  <body>
    <slot />
    <script>import '../scripts/app.js';</script>
  </body>
</html>
