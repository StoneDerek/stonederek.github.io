---
import site from '../data/site.json';
import css from '../styles/portfolio.css?inline';
const base = import.meta.env.BASE_URL;
const { title = site.title, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" data-project-favicon />
    <style is:inline set:html={css}></style>
  </head>
  <body>
    <slot />
  </body>
</html>
