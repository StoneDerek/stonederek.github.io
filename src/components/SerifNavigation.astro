---
import site from '../data/site.json';
import { resumeURL } from '../data/resume.js';
import '../styles/navigation-contrast.css';

const { page = 'home', mode = 'desktop' } = Astro.props;
const base = import.meta.env.BASE_URL;
const links = [
  { label: 'Home', page: 'home', href: base },
  { label: 'Work', page: 'work', href: `${base}projects/` },
  { label: 'About', page: 'about', href: `${base}about/` },
  { label: 'Art', page: 'art', href: `${base}art/` },
  { label: 'Resume', page: 'resume', href: resumeURL(base), professional: true, newTab: true },
  { label: 'LinkedIn', href: site.linkedin, newTab: true },
];
---
<nav class:list={['serif-navigation', `serif-navigation-${mode}`]} aria-label="Main navigation">
  <ul class="serif-nav-list">
    {links.map(link => (
      <li class:list={{ 'serif-professional-start': link.professional }}>
        <a
          class="serif-nav-link"
          href={link.href}
          aria-current={link.page === page ? 'page' : undefined}
          data-work-index={link.page === 'work' ? '' : undefined}
          data-resume-link={link.page === 'resume' ? '' : undefined}
          target={link.newTab ? '_blank' : undefined}
          rel={link.newTab ? 'noopener noreferrer' : undefined}
          aria-label={link.newTab ? `${link.label} (opens in a new tab)` : undefined}
        >{link.label}</a>
      </li>
    ))}
  </ul>
</nav>
