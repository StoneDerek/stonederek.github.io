---
import projects from '../data/projects.json';
import { renderArtProse } from '../data/art-prose.js';
import { prepareArtEntry } from '../scripts/art-startup.js';
import ArtImageViewer from './ArtImageViewer.astro';
import ArtPuzzle from './ArtPuzzle.astro';
import '../styles/art.css';
const art = projects.find(project => project.slug === 'art');
const works = art.caseStudy.sections;
const base = import.meta.env.BASE_URL;
const source = src => `${base}${src}`;
const serialized = JSON.stringify(art).replace(/</g, '\\u003c');
---
<div class="art-collection" data-art-root data-base={base} data-art-index="0" style={`--art-initial-aspect:${works[0].media[0].width / works[0].media[0].height}`}>
  <header class="art-heading">
    <h1 class="serif-page-title" data-art-title data-detail-title tabindex="-1">Untitled #1</h1>
  </header>
  <div data-art-collection>
    <details class="art-collection-note">
      <summary>About this collection</summary>
      <p>{art.description}</p><p>{art.note}</p>
    </details>
    <section class="art-gallery" role="region" aria-roledescription="carousel" aria-label="Artworks">
      <p id="art-gallery-instructions" class="sr-only">Use the arrow keys or thumbnails to choose an artwork. Select the main image to enlarge it.</p>
      <div class="art-stage" data-art-stage tabindex="0" aria-label="Artwork gallery" aria-describedby="art-gallery-instructions">
        <div class="art-track" data-art-track>
          {works.map((work, index) => (
            <figure class="art-slide" data-art-item={index} id={`artwork-${work.title}`} aria-hidden={index !== 0 ? 'true' : 'false'} inert={index !== 0} role="group" aria-roledescription="slide" aria-label={`Untitled #${index + 1}`}>
              <button type="button" class="art-image-open" data-image-open aria-label={`Enlarge Untitled #${index + 1}`} aria-haspopup="dialog" aria-controls="project-image-viewer">
                <img src={source(work.media[0].src)} alt={work.media[0].alt} width={work.media[0].width} height={work.media[0].height} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" draggable="false" />
              </button>
            </figure>
          ))}
        </div>
      </div>
      <div class="art-filmstrip">
        <div class="art-rail" data-art-rail tabindex="0" role="group" aria-label="Choose an artwork">
          <div class="art-thumbnails" data-art-thumbnails>
            {works.map((work, index) => (
              <button type="button" class="art-thumbnail" data-art-select={index} aria-label={`Show Untitled #${index + 1}`} aria-current={index === 0 ? 'true' : undefined} aria-controls={`artwork-${work.title}`}>
                <img src={source(work.media[0].src)} alt="" width={work.media[0].width} height={work.media[0].height} loading="lazy" decoding="async" draggable="false" />
              </button>
            ))}
          </div>
        </div>
        <span class="art-selection-frame" data-art-selection-frame aria-hidden="true"></span>
      </div>
      <p class="sr-only" data-art-announcement role="status" aria-live="polite" aria-atomic="true">Untitled #1</p>
    </section>
    <div class="art-details project-case-study" data-art-details data-layout="art" set:html={renderArtProse(art)}></div>
  </div>
  <ArtPuzzle />
  <ArtImageViewer />
  <script type="application/json" id="art-data" set:html={serialized}></script>
</div>
<script is:inline data-art-entry set:html={`(${prepareArtEntry.toString()})(document.currentScript.previousElementSibling);`} />
<noscript><style>.serif-site .art-stage{height:auto}.serif-site .art-track{display:block;transform:none}.serif-site .art-slide{width:100%;height:auto;margin-bottom:24px}.serif-site .art-image-open img{height:auto}.serif-site .art-filmstrip{display:none}</style></noscript>
