---
import projects from '../data/projects.json';

const base = import.meta.env.BASE_URL;
const work = projects.filter(project => project.slug !== 'art');
const first = work[0];
const serialized = JSON.stringify(projects).replace(/</g, '\\u003c');
---
<section class="work-index" data-work-grid aria-labelledby="work-title">
  <header class="work-heading">
    <h1 id="work-title" class="serif-page-title" data-work-heading tabindex="-1">Work</h1>
    <p class="serif-page-intro">Projects in engineering, simulation, and machine learning.</p>
  </header>
  <div class="work-project-grid">
    {work.map((project, index) => (
      <article class="work-project">
        <a class="work-project-open" href={`${base}projects/#project=${project.slug}`} data-work-project={project.slug} aria-labelledby={`work-${project.slug}-title`} aria-describedby={project.galleryMethod ? `work-${project.slug}-method` : undefined}>
          <img
            class="work-project-image"
            src={`${base}${project.image}`}
            alt={project.imageAlt}
            width={project.imageWidth || 1920}
            height={project.imageHeight || 1200}
            style={`object-position:${project.position || '50% 50%'};object-fit:${project.fit || 'cover'}`}
            loading={index < 2 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
          <span class="work-project-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h2 id={`work-${project.slug}-title`} class="work-project-title">{project.galleryTitle || project.title}</h2>
          {project.galleryMethod && <p id={`work-${project.slug}-method`} class="work-project-method">{project.galleryMethod}</p>}
        </a>
      </article>
    ))}
  </div>
</section>

<section id="work-project-article" class="project-view work-article" data-work-article data-project-view aria-labelledby="work-detail-title" hidden>
  <article class="project-page work-project-page">
    <header class="project-toolbar">
      <a class="back-button" href={`${base}projects/`} data-work-close><svg class="control-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m7 3-5 5 5 5M2 8h12" /></svg> Back to Work</a>
      <span class="project-view-meta"><span data-detail-category>{first.category}</span><span data-detail-period hidden={!first.year}> / <span data-detail-year>{first.year}</span></span></span>
      <span class="project-view-number" data-detail-number>01 / {String(work.length).padStart(2, '0')}</span>
    </header>
    <section class="project-story">
      <div><p class="dialog-eyebrow" data-detail-eyebrow>{first.eyebrow || ''}</p><h1 id="work-detail-title" data-detail-title tabindex="-1">{first.title}</h1></div>
      <div class="project-prose"><p class="detail-description" data-detail-description>{first.description}</p><p class="detail-note" data-detail-note>{first.note}</p></div>
    </section>
    <div class="project-media" data-detail-media data-asset-base={base} hidden></div>
    <div class="project-case-study" data-detail-case-study hidden></div>
  </article>
</section>

<dialog id="project-image-viewer" class="project-image-viewer" data-image-viewer aria-label="Enlarged project image">
  <div class="image-viewer-toolbar">
    <span class="image-viewer-label" data-image-label>Image</span>
    <div class="image-viewer-zoom-controls" role="group" aria-label="Image zoom">
      <button type="button" class="image-viewer-zoom" data-image-zoom-out aria-label="Zoom out" title="Zoom out (−)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14" /></svg></button>
      <span class="image-viewer-scale" data-image-scale aria-label="Zoom level">100%</span>
      <button type="button" class="image-viewer-zoom" data-image-zoom aria-label="Zoom in" title="Zoom in (+)"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M12 5v14" /></svg></button>
      <button type="button" class="image-viewer-zoom image-viewer-fit" data-image-fit aria-label="Fit image to viewer" title="Fit image (0)">Fit</button>
    </div>
    <button type="button" class="image-viewer-close" data-image-close aria-label="Close enlarged image" title="Close enlarged image" autofocus><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg></button>
  </div>
  <figure class="image-viewer-figure">
    <div class="image-viewer-canvas" data-image-canvas tabindex="0" role="group" aria-label="Image inspection. Use plus and minus to zoom, arrow keys to pan, and zero to fit."><img data-image-full alt="" decoding="async" draggable="false" /></div>
    <figcaption data-image-caption hidden></figcaption>
  </figure>
</dialog>

<script type="application/json" id="work-data" set:html={serialized}></script>
