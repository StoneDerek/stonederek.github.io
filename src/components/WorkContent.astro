---
import projects from '../data/projects.json';
import PlaceholderParagraph from './PlaceholderParagraph.astro';

const base = import.meta.env.BASE_URL;
const work = projects.filter(project => project.slug !== 'art');
const first = work[0];
const serialized = JSON.stringify(projects.map(({ slug, legacySlugs, title }) => ({ slug, legacySlugs, title }))).replace(/</g, '\\u003c');
const cat = ['  ╱|、', '(˚ˎ 。7', ' |、˜〵', 'じしˍ,)ノ'].join('\n');
---
<section class="work-index" data-work-grid aria-labelledby="work-title">
  <h1 id="work-title" class="sr-only" data-work-heading tabindex="-1">Work</h1>
  <div class="work-project-grid">
    {work.map((project, index) => (
      <article class="work-project">
        <a class="work-project-open" href={`${base}projects/#project=${project.slug}`} data-work-project={project.slug} aria-labelledby={`work-${project.slug}-title`} aria-describedby={`work-${project.slug}-method`}>
          <img
            class="work-project-image"
            src={`${base}${project.image}`}
            alt={project.imageAlt}
            width={project.imageWidth || 1920}
            height={project.imageHeight || 1200}
            style={`object-position:${project.position || '50% 50%'};object-fit:${project.fit || 'cover'}`}
            loading={index < 2 ? 'eager' : 'lazy'}
            fetchpriority={index === 0 ? 'high' : 'auto'}
            decoding="async"
          />
          <h2 id={`work-${project.slug}-title`} class="work-project-title">Untitled #{index + 1}</h2>
          <p id={`work-${project.slug}-method`} class="work-project-method">{[project.galleryTitle || project.title, project.galleryMethod].filter(Boolean).join(' ')}</p>
        </a>
      </article>
    ))}
    <div class="work-coming-soon">
      <pre class="work-coming-cat" aria-hidden="true">{cat}</pre>
      <p>More coming soon</p>
    </div>
  </div>
</section>

<section id="work-project-article" class="project-view work-article" data-work-article data-project-view aria-labelledby="work-detail-title" hidden>
  <article class="project-page work-project-page">
    <header class="project-toolbar">
      <a class="back-button" href={`${base}projects/`} data-work-close><svg class="control-arrow" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="m7 3-5 5 5 5M2 8h12" /></svg> Back to Work</a>
    </header>
    <h1 id="work-detail-title" class="sr-only" data-detail-title tabindex="-1">{first.title}</h1>
    <div class="work-project-prose"><PlaceholderParagraph /></div>
  </article>
</section>

<script type="application/json" id="work-data" set:html={serialized}></script>
