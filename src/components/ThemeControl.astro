<section class="theme-control" data-theme-control aria-labelledby="theme-control-label" hidden>
  <h2 id="theme-control-label">Appearance</h2>
  <button type="button" class="theme-switch" data-theme-switch role="switch" aria-checked="false" aria-label="Dark mode">
    <span class="theme-option theme-option-light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" /></svg>Light</span>
    <span class="theme-option theme-option-dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 14A9 9 0 0 1 10 3.2a9 9 0 1 0 10.8 10.8Z" /><path d="M17 3v4m-2-2h4" /></svg>Dark</span>
  </button>
  <p class="theme-control-note"><span data-theme-status aria-live="polite">Following system</span><button type="button" data-theme-system hidden>Use system</button></p>
</section>
