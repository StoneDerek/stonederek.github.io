---
import site from '../data/site.json';
import { shortDrift } from '../data/section-motion.js';
const base = import.meta.env.BASE_URL;
---
<footer class="profile-footer" data-section-motion transition:name="section-footer" transition:animate={shortDrift}>
  <a href={`mailto:${site.email}`}>{site.email}</a>
  <div><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a><a href={`${base}resume/`} data-resume-link target="_blank" rel="noopener">Résumé</a></div>
  <span class="profile-signature" aria-hidden="true">ds.</span>
</footer>
