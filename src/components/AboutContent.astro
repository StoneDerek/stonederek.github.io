---
import PlaceholderParagraph from './PlaceholderParagraph.astro';

const { prefix = '' } = Astro.props;
const target = (id) => `${prefix}${id}`;
---
<h1 id={target('about-title')} class="native-profile-title sr-only" aria-label="About" tabindex="-1">About</h1>
<div id={target('interests')} class="about-story"><PlaceholderParagraph /></div>
