---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProfileFooter from '../components/ProfileFooter.astro';
import site from '../data/site.json';
import { projectIcon } from '../data/project-icons.js';
const base = import.meta.env.BASE_URL;
const sections = [
  ['starting-point', 'Lorem ipsum'],
  ['interests', 'Dolor sit amet'],
  ['approach', 'Consectetur adipiscing elit'],
  ['projects-so-far', 'Sed do eiusmod'],
  ['outside-engineering', 'Ut enim ad minim'],
