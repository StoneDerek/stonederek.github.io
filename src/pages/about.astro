---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import ProfileFooter from '../components/ProfileFooter.astro';
import site from '../data/site.json';
import { shortDrift } from '../data/section-motion.js';
import { projectIcon } from '../data/project-icons.js';
import AboutContent from '../components/AboutContent.astro';
import { aboutPalette } from '../data/section-palettes.js';
---
<Layout title={`${site.name} — About`} description="Lorem ipsum dolor sit amet, consectetur adipiscing elit." favicon={projectIcon(aboutPalette)}>
  <div class="profile-shell about-shell">
    <a class="skip-link" href="#about-title">Skip to About</a>
    <SiteHeader page="about" />
    <main data-section-motion transition:name="about-content" transition:animate={shortDrift} class="profile-main about-main">
      <AboutContent />
    </main>
    <ProfileFooter page="about" />
  </div>
  </Layout>
