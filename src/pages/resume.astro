---
import { hasResume, resumeURL } from '../data/resume.js';
import SerifShell from '../components/SerifShell.astro';
const base = import.meta.env.BASE_URL;
---
<SerifShell page="resume" contentId="resume-content">
  <section class="serif-resume">
    <h1 class="serif-page-title">Resume</h1>
    {hasResume ? (
      <p class="serif-page-intro"><a class="serif-resume-link" data-resume-pdf href={resumeURL(base)}>View resume PDF</a></p>
    ) : (
      <p class="serif-page-intro resume-message">The latest resume will be available here soon.</p>
    )}
  </section>
</SerifShell>
