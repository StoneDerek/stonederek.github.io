---
import { hasResume, resumeURL } from '../data/resume.js';
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
const base = import.meta.env.BASE_URL;
---
<Layout title={`Resume — ${site.name}`} description={`The latest resume for ${site.name}.`}>
  <main class="resume-page">
    <a class="resume-home" data-resume-home href={base}><svg class="control-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="m7 3-5 5 5 5M2 8h12" /></svg> {site.header}</a>
    <header><p class="resume-label">Resume</p><h1>{site.name}</h1></header>
    {hasResume ? (
      <a class="resume-pdf" data-resume-pdf href={resumeURL(base)}>View resume PDF <svg class="control-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" /></svg></a>
    ) : (
      <p class="resume-message">The latest resume will be available here soon.</p>
    )}
    <footer><a href={`mailto:${site.email}`}>{site.email}</a><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <svg class="control-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" /></svg></a></footer>
  </main>
</Layout>
<style>
  .resume-page { max-width: 720px; margin: 0 auto; padding: max(32px, env(safe-area-inset-top)) 24px 40px; color: #191919; }
  .resume-page a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: inherit; text-decoration: none; }
  .resume-page a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .resume-page a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  .resume-home { font-size: 14px; }
  header { margin-top: clamp(56px, 12vh, 120px); }
  .resume-label { margin: 0 0 16px; font-size: 13px; }
  h1 { margin: 0; font-size: clamp(40px, 8vw, 72px); line-height: 1.05; font-weight: 500; letter-spacing: -.05em; }
  .resume-message { margin: 32px 0 0; line-height: 1.6; }
  .resume-page .resume-pdf { margin-top: 32px; padding: 10px 16px; border-radius: 5px; background: var(--default-accent); color: var(--default-ink); font-weight: 600; }
  footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; margin-top: 64px; padding-top: 16px; border-top: 1px solid #19191930; font-size: 14px; }
</style>
